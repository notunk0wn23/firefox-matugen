{
  "manifest_version": 3,
  "name": "Matugen Firefox",
  "version": "1.1",
  "description": "Theme Firefox from a matugen-generated color palette, and live-reload it whenever the palette changes.",
  "homepage_url": "https://github.com/spacedouut/firefox-matugen",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "theme", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-matugen@spacedouut.github.io",
      "strict_min_version": "115.0"
    }
  }
}
